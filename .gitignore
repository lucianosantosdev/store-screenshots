.gradle/
build/
.idea/
*.iml
local.properties
.DS_Store
.kotlin/
captures/
plugin/bin/

# PNGs are never versioned — screenshot runs write full-resolution PNGs, but only the small JPEGs
# (produced by the root `compressScreenshots` task) are committed for the README.
*.png

# …except the test reference images. These are not screenshot output — they are the fixtures the
# comparison tests measure against: the status bar captures taken off real Apple hardware, and the
# frame goldens that hold the rendered frame to what it looked like when it was last approved.
!library/src/test/resources/reference/*.png
